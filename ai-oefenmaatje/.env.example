PORT=3001

# OpenAI (live AI companion responses)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# TTS provider: elevenlabs | azure | google | browser | none
TTS_PROVIDER=elevenlabs

# ElevenLabs
ELEVENLABS_API_KEY=
# Optional — leave empty to auto-pick a free premade voice from your account
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Azure Speech
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
AZURE_SPEECH_VOICE=nl-NL-FennaNeural

# Google Cloud Text-to-Speech
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=nl-NL-Wavenet-A
