PORT=3001

# Google GenAI (optional — lesson uses scripted lines without this)
GOOGLE_GENAI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# TTS: browser (default, free) | azure | google
TTS_PROVIDER=browser

# Azure Speech (only if TTS_PROVIDER=azure)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
AZURE_SPEECH_VOICE=nl-NL-FennaNeural

# Google Cloud Text-to-Speech (only if TTS_PROVIDER=google)
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=nl-NL-Wavenet-A
